class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        # Step 1: Create an empty dictionary to store {number: index}
        seen = {}
        
        # Step 2: Loop through the list using enumerate to get both the index (i) and the number (num)
        for i, num in enumerate(nums):
            # Calculate what number we need to reach the target
            complement = target - num
            
            # Step 3: Check if this complement is already in our dictionary
            if complement in seen:
                # If found, return the index of the complement and the current index
                return [seen[complement], i]
            
            # Step 4: If not found, store the current number and its index in the dictionary
            seen[num] = i
