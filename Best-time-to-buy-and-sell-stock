class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        # Step 1: Initialize the left side of the window and max profit
        left = 0 
        max_profit = 0
        
        # Step 2: The right side of the window expands automatically in a loop
        for right in range(1, len(prices)):
            
            # If the window is valid (sell price is higher than buy price)
            if prices[left] < prices[right]:
                # Calculate the profit for the current window size
                current_profit = prices[right] - prices[left]
                # Update the maximum profit
                max_profit = max(max_profit, current_profit)
            else:
                # If the condition breaks (we found an even cheaper price),
                # we slide the left side of our window straight to the right side.
                left = right
        return max_profit
