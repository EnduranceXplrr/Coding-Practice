class Solution:
    def maxProfit(self, prices: List[int]) -> int:

        left = 0
        max_profit = 0
        total_profit = 0

        for right in range(1, len(prices)):

            if prices[right] > prices[left]:
                sell = prices[right] - prices[left]
                total_profit += sell
                max_profit =  max(total_profit, max_profit)
            
            left = right
            
        return max_profit
        
