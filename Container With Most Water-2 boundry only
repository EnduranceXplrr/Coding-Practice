class Solution:
    def maxArea(self, height: List[int]) -> int:
        most_water = 0
        i = 0
        j = len(height) -1
        while i < j:
            boundary = min(height[i] , height[j])
            most_water = max(most_water, (boundary * (j-i)))
            if height[i] < height[j]:
                i += 1
            else:
                j -= 1
        return most_water
