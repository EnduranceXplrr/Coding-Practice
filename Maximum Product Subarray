class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        # Step 1: Initialize your tracking variables
        # We start by assuming the first number is both our current and max sum
        current_sum = nums[0]
        max_sum = nums[0]
        
        # Step 2: Loop through the rest of the array starting from index 1
        for i in range(1, len(nums)):
            # The "Fresh Start" choice:
            # Should we add the current number to our existing sum, 
            # or start a brand new window from the current number?
            current_sum = max(nums[i], current_sum + nums[i])
            
            # Update our global maximum if the current window sum is the biggest seen so far
            max_sum = max(max_sum, current_sum)
            
        return max_sum
