class Solution:
    def productExceptSelf(self, nums: List[int]) -> List[int]:
        n = len(nums)
        
        # Step 1: Initialize the answer array with 1s
        # It must be the same size as the input array
        answer = [1] * n
        
        # Step 2: Pass 1 - Calculate Prefix (Left) Products
        # 'prefix_product' keeps track of the multiplication of everything to the left
        prefix_product = 1
        for i in range(n):
            answer[i] = prefix_product
            prefix_product *= nums[i]  # Update the running product for the next element
            
        # Step 3: Pass 2 - Calculate Suffix (Right) Products on the fly
        # 'suffix_product' keeps track of the multiplication of everything to the right
        suffix_product = 1
        for i in range(n - 1, -1, -1):  # Loop backwards from n-1 down to 0
            answer[i] *= suffix_product  # Multiply the existing left product by the right product
            suffix_product *= nums[i]   # Update the running product for the next element
            
        return answer
