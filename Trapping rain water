class Solution:
    def trap(self, height: List[int]) -> int:
        start = 0
        end = 0
        current = height[0]
        n = len(height)
        for i in range (0, n-1):
            if current < height[i+1]:
                start = i+1
                end = i+1
                current = height[i+1]
            else:
                start = i
                end = i
                break

        rain_w,g_i,t_v = 0,0,0
        
        for i in range(start,n-1):
            if current > height[i+1]:
                g_i += 1
                t_v += height[i+1]
            else:
                end = i+1
                rain_w = rain_w + g_i*current - t_v
                current = height[i+1]
                g_i, t_v = 0,0
                
        g_i, t_v = 0,0
        current = height[n-1]
        for i in range(n-1,end,-1):
            if current < height[i-1]:
                start = i-1
                current = height[i-1]
            else:
                start = i
                break

        for i in range(start,end, -1):
            if current > height[i-1]:
                g_i += 1
                t_v += height[i-1]
            else:
                
                rain_w = rain_w + g_i*current - t_v
                current = height[i-1]
                g_i, t_v = 0,0
                
        return rain_w
