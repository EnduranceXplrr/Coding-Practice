class Solution:
    def convert(self, s: str, numRows: int) -> str:
        if numRows == 1 or numRows >= len(s):
            return s
        
        result = []
        n = len(s)
        cycle = 2 * numRows - 2
        
        for r in range(numRows):
            for i in range(r, n, cycle):
                result.append(s[i])
                
                diag_idx = i + cycle - 2 * r
                if r != 0 and r != numRows - 1 and diag_idx < n:
                    result.append(s[diag_idx])
                    
        return "".join(result)
